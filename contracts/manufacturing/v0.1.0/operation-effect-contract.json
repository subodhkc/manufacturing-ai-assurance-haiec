  "systemSpecificLimits": {
    "SYS-217": "3 engines automatic protective hold; 40 exact Quality Supervisor approval; 51 escalate to Plant Quality Manager, not blanket denied. Release needs separate quality disposition.",
    "SYS-340": "Model score/defect prevalence not QMS disposition or measured classifier performance.",
    "SYS-FC1": "Planner review and frozen production horizon; child agent authority cannot expand without delegation.",
    "SYS-PO12": "Reference threshold $15,000 is fictional; currency, supplier, amount, item, target and approver all bind.",
    "SYS-MNT88": "CMMS work request not maintenance execution, repair or return-to-service proof.",
    "SYS-SUP12": "PPAP/supplier-part-site-revision effective approval and current QMS lot state required.",
    "SYS-SCH5": "Optimized plan not APS-native schedule commit; MES execution separate.",
    "SYS-DYN412": "19 exposed setpoints vs 3 delegated fixture scope; no public PLC/OT write.",
    "SYS-WH15": "QMS hold at shipment time + native WMS shipment confirmation exact lot."
  },
