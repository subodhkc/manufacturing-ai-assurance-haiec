  "proposedProfiles": {
    "manufacturing_action_event_v1": {
      "required": [
        "sourceId",
        "producerId",
        "organizationId",
        "aiSystemId",
        "principalRef",
        "agentInstanceRef",
        "operationRef",
        "requestId",
        "resourceRef",
        "sourceEventTime",
        "receivedTime",
        "payloadDigest",
        "claimType"
      ],
      "optional": [
        "transactionId",
        "policyDigest",
        "actionId",
        "runId"
      ],
      "rejectIf": [
        "missingExactOrgSystem",
        "missingPrincipal",
        "unqualifiedSourceRoleForClaim"
      ]
    },
    "manufacturing_mes_qms_state_v1": {
      "required": [
        "sourceId",
        "producerId",
        "transactionId",
        "siteId",
        "resourceRef",
        "nativeVersion",
        "observedAt",
        "sourceEventTime",
        "receivedTime",
        "before",
        "after",
        "claimType"
      ],
      "optional": [
        "partRevision",
        "workOrderId",
        "lotId",
        "unit"
      ],
      "rejectIf": [
        "missingTransactionId",
        "targetMismatch",
        "unqualifiedNativeProducer"
      ]
    },
    "manufacturing_policy_iam_v1": {
      "required": [
        "producerId",
        "principalId",
        "operationScope",
        "targetScope",
        "effectiveFrom",
        "effectiveTo",
        "claimType"
      ],
      "optional": [
        "approvedPolicyId",
        "effectiveGrantId",
        "approverRef",
        "roles"
      ],
      "rejectIf": [
        "unqualifiedApprovalSource",
        "missingEffectiveWindow"
      ]
    },
    "manufacturing_vision_observation_v1": {
      "required": [
        "sourceId",
        "imageDigest",
        "modelVersion",
        "partRevision",
        "recipeVersion",
        "measurement",
        "unit",
        "observedAt"
      ],
      "optional": [
        "camera",
        "labeledOutcome",
        "validatedContextId"
      ],
      "rejectIf": [
        "incomparableUnitWithoutConversion"
      ]
    }
  },
  "comparisonChecks": [
    {
      "caseId": "E-01",
      "inputSituation": "same operation new vendor field names with pinned map",
      "requiredBehavior": "EXACT_SAME_CANONICAL_OPERATION_ONLY_AFTER_MAPPING",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-02",
      "inputSituation": "duplicate tx IDs at different sites",
      "requiredBehavior": "REJECT_CROSS_SOURCE_JOIN",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-03",
      "inputSituation": "missing lot part revision on supplier release",
      "requiredBehavior": "INCOMPLETE_SCOPE",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-04",
      "inputSituation": "OTel HTTP 200 with no native commit",
      "requiredBehavior": "NO_EFFECT_PROVEN",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-05",
      "inputSituation": "OPC UA AccessLevel write, UserAccessLevel deny",
      "requiredBehavior": "NO_EFFECTIVE_GRANT",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-06",
      "inputSituation": "Sparkplug offline state",
      "requiredBehavior": "TELEMETRY_DEGRADED_NOT_SUCCESS",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-07",
      "inputSituation": "MTConnect alarm without maintenance transaction",
      "requiredBehavior": "CONDITION_ONLY",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-08",
      "inputSituation": "B2MML unvalidated JSON conversion",
      "requiredBehavior": "REJECT_SCHEMA_UNTRUSTED",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-09",
      "inputSituation": "future-dated recipe version",
      "requiredBehavior": "QUARANTINE_CLOCK_SKEW",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-10",
      "inputSituation": "unapproved updated OpenAPI sourceHash",
      "requiredBehavior": "REJECT_SOURCE_VERSION",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-11",
      "inputSituation": "caller supplies sourceRole SERVICE_NATIVE_RECORD",
      "requiredBehavior": "STRIP_AND_SERVER_QUALIFY",
      "status": "NOT_EXECUTED"
    },
    {
      "caseId": "E-12",
      "inputSituation": "client declared CODE_CAPABLE read-only tool",
      "requiredBehavior": "CODE_CAPABILITY_NOT_ESTABLISHED",
      "status": "NOT_EXECUTED"
    }
  ],
  "vendorPortability": "Define a reviewed alias map per source family/version, not hardcode the nine fixture system names. Vendor onboarding requires source identity and authorization configuration; no zero-configuration safety/authority claims.",
  "platformOwnership": "HAIEC private canonical intake, source binder and evidence normalization; public repo publishes fictional samples only; no separate evaluation engine.",
  "externalReferences": [
    "https://reference.opcfoundation.org/specs/OPC-10030/full",
    "https://reference.opcfoundation.org/specs/OPC-10031-4/full",
    "https://model.mtconnect.org/Version2.2/ObservationInformationModel/",
    "https://sparkplug.eclipse.org/specification/version/3.0/",
    "https://github.com/MESAInternational/B2MML-BatchML"
  ],
  "exitCriteria": [
    "source+claim roles register/qualify server side",
    "all comparison checks reviewed",
    "two vendor shapes normalized without literal system ID matching",
    "invalid/unknown source preserves NOT_ASSESSED",
    "same data+version deterministic normalization",
    "sourceRefs retained in genuine persisted evaluation"
  ],
  "evaluated": false
